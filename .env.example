# ── Runtime mode ──────────────────────────────────────────────────────────────
# local: single user, local database/media, no Supabase or R2 configuration.
# cloud: Supabase auth/database and Cloudflare R2 storage.
# This choice is embedded in the client bundle during `next build`; rebuild after
# changing it. See .env.guest for the local single-user template.
HELIOS_MODE=cloud
# KIE_API_KEY is read in local mode (cloud mode uses per-user keys via Settings).
KIE_API_KEY=

# ── Authentication and callback security ──────────────────────────────────────
# HELIOS_ADMIN_PASSWORD_HASH and HELIOS_SESSION_SECRET are required in local mode.
# Generate the hash with: pnpm local-auth:hash 'a-long-unique-password'
# Generate both secrets independently with: openssl rand -base64 48
# KIE_CALLBACK_SECRET is required in both local and cloud modes.
# These values are server-only. Never prefix them with NEXT_PUBLIC_.
HELIOS_ADMIN_PASSWORD_HASH=
HELIOS_SESSION_SECRET=
KIE_CALLBACK_SECRET=
# Optional: trust X-Real-IP from your private nginx/Caddy hop for per-IP login
# throttling. Leave false unless clients cannot reach Next.js directly.
HELIOS_TRUST_PROXY=false

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_DEMO_MODE=true to replace the sign-in/signup modal with a
# prompt pointing visitors to the GitHub repo to self-host.
NEXT_PUBLIC_DEMO_MODE=

# ── Kie.ai ────────────────────────────────────────────────────────────────────
# No shared API key needed — each user saves their own key via the Settings UI.

# Public URL where kie.ai POSTs job completion results (webhook).
# Must be reachable from the internet.
# Local dev: use ngrok → ngrok http 3000
# Production: your deployed domain, e.g. https://your-app.vercel.app
CALLBACK_BASE_URL=
# The app automatically sends Kie.ai a callback URL containing the separate
# KIE_CALLBACK_SECRET. Keep CALLBACK_BASE_URL free of query parameters.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID: Cloudflare dashboard sidebar
R2_ACCOUNT_ID=
# API token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN URL — enable public access on the bucket first
R2_PUBLIC_URL=

# ── Azure OpenAI (optional) ───────────────────────────────────────────────────
# Only needed if routing models through Azure AI Foundry instead of Kie.ai
AZURE_API_KEY=
