# ── Local single-user mode ────────────────────────────────────────────────────
# Copy this file to .env.local to run without Supabase or R2.
# HELIOS_MODE is embedded in the client bundle during `next build`, so rebuild
# after changing modes. GUEST_MODE remains supported for older installations.

HELIOS_MODE=local

# Your kie.ai API key (from https://kie.ai → account settings)
KIE_API_KEY=your_kie_api_key_here

# Public callback URL. Kie.ai must be able to reach this address.
# For local development, run `ngrok http 3000` and paste its HTTPS URL here.
CALLBACK_BASE_URL=https://xxxx.ngrok-free.app

# Supabase and R2 variables are not needed in local mode.

# ── Data is persisted to disk ─────────────────────────────────────────────────
# Generated files  → public/generated/   (served as static assets)
# Generation history → data/guest-db.json
